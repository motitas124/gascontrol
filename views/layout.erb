<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>GasControl</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css?v=<%= css_version %>">
</head>
<body>
  <header class="cabecera">
    <div class="cabecera__interior">
      <a class="marca" href="/gasolineras/nueva">
        <svg class="marca__logo" viewBox="0 0 40 40" aria-hidden="true">
          <rect x="7" y="5" width="18" height="30" rx="3" fill="#fff"/>
          <rect x="10" y="9" width="12" height="8" rx="1.5" fill="#12263F"/>
          <path d="M25 14h4a3 3 0 0 1 3 3v11a2.5 2.5 0 0 0 5 0V15l-4-4" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="5" y="35" width="22" height="3" rx="1.5" fill="#00A6D6"/>
        </svg>
        <span>GasControl</span>
      </a>
      <% if logged_in? %>
        <div class="usuario">
          <span class="usuario__correo"><%= h(current_user.email) %></span>
          <form class="usuario__formulario" action="/logout" method="post">
            <button type="submit" class="boton boton--fantasma">Cerrar sesión</button>
          </form>
        </div>
      <% end %>
    </div>
  </header>

  <main class="pagina">
    <%= yield %>
  </main>
</body>
</html>
